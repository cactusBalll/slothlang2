// seed helper for mod_crossmod_generics.sl (not run directly)
import "__sloth";

func qsort_prv<T>(a: Array<T>, lo: int, hi: int, cmp: (T, T) -> int): unit {
    if lo >= hi {
        return;
    }
    let pivot = a[(lo + hi) / 2];
    var i = lo;
    var j = hi;
    while i <= j {
        while cmp(a[i], pivot) < 0 {
            i = i + 1;
        }
        while cmp(a[j], pivot) > 0 {
            j = j - 1;
        }
        if i <= j {
            let t = a[i];
            a[i] = a[j];
            a[j] = t;
            i = i + 1;
            j = j - 1;
        }
    }
    if lo < j {
        qsort_prv(a, lo, j, cmp);
    }
    if i < hi {
        qsort_prv(a, i, hi, cmp);
    }
}

pub func wrapped<T>(x: T): Array<T> {
    return [x];
}

pub func sorted_by<T>(a: Array<T>, cmp: (T, T) -> int): Array<T> {
    var c = a[0..a.len()];
    qsort_prv(c, 0, c.len() - 1, cmp);
    return c;
}

pub func head<T>(a: Array<T>): T? {
    if a.len() == 0 {
        return nil;
    }
    return a[0];
}
