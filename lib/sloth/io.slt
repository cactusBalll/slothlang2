// sloth2 stdlib: io (IO layer, IO-P2).
//
// Thin sloth surface over the sloth-rt IO primitives: mutable byte buffers,
// monotonic clock, errno helpers and the unified event backend (select / poll
// / epoll / kqueue / io_uring). The event *queue* policy lives in
// `event.slt`; this file is the mechanism.
//
// Ownership: `Bytes` / `EvBuf` / `EvLoop` are opaque `extern type` handles, so
// codegen never emits ARC retain/release on them. Call the matching `*_free`
// when done (a missed free leaks, matching the runtime discipline).
//
// The runtime `__sloth_*` externs are declared by the injected prelude
// (`lib/prelude/abi.slt`); the pseudo-import below grants this stdlib module
// the right to call those reserved symbols.

import "__sloth";

pub func bytes_new(cap: int): Bytes {
    return __sloth_bytes_new(cap);
}

pub func bytes_free(b: Bytes): unit {
    __sloth_bytes_free(b);
}

pub func bytes_len(b: Bytes): int {
    return __sloth_bytes_len(b);
}

pub func bytes_cap(b: Bytes): int {
    return __sloth_bytes_cap(b);
}

pub func bytes_ensure(b: Bytes, cap: int): int {
    return __sloth_bytes_ensure(b, cap);
}

pub func bytes_set_len(b: Bytes, n: int): unit {
    __sloth_bytes_set_len(b, n);
}

pub func bytes_get(b: Bytes, i: int): int {
    return __sloth_bytes_get(b, i);
}

pub func bytes_set(b: Bytes, i: int, v: int): unit {
    __sloth_bytes_set(b, i, v);
}

pub func bytes_fill(b: Bytes, off: int, v: int, n: int): unit {
    __sloth_bytes_fill(b, off, v, n);
}

pub func bytes_append(b: Bytes, v: int): int {
    return __sloth_bytes_append(b, v);
}

pub func bytes_copy_from_str(b: Bytes, off: int, s: str): int {
    return __sloth_bytes_copy_from_str(b, off, s);
}

pub func bytes_to_str(b: Bytes, off: int, len: int): str {
    return __sloth_bytes_to_str(b, off, len);
}

pub func bytes_as_str(b: Bytes): str {
    return __sloth_bytes_as_str(b);
}

// ---------------- clock + errno ----------------

/// milliseconds from a monotonic clock (only differences are meaningful)
pub func now_ms(): int {
    return __sloth_now_ms();
}

pub func sleep_ms(ms: int): unit {
    __sloth_sleep_ms(ms);
}

/// last raw errno (positive)
pub func errno(): int {
    return __sloth_io_errno();
}

/// did a `-errno` syscall result mean "try again later"?
pub func would_block(r: int): bool {
    return __sloth_io_would_block(r) != 0;
}

/// did a `-errno` syscall result mean the peer went away?
pub func conn_closed(r: int): bool {
    return __sloth_io_conn_closed(r) != 0;
}

// ---------------- event backend ----------------

// ---------------- async completion (cross-thread) ----------------
// A worker OS thread signals an eventfd when a task finishes; the event loop
// watches the fd and wakes the waiting fiber. Safe to signal before the watch
// is registered (the counter keeps the fd readable until drained).

/// create a completion fd (eventfd), or <0 on error
pub func async_new(): int {
    return __sloth_async_new();
}

/// signal a completion fd from any thread
pub func async_signal(fd: int): int {
    return __sloth_async_signal(fd);
}

/// reset a completion fd (nonblocking)
pub func async_drain(fd: int): int {
    return __sloth_async_drain(fd);
}

/// close a completion fd
pub func async_free(fd: int): int {
    return __sloth_async_free(fd);
}

// backend kinds
pub func kind_select(): int {
    return 0;
}
pub func kind_poll(): int {
    return 1;
}
pub func kind_epoll(): int {
    return 2;
}
pub func kind_kqueue(): int {
    return 3;
}
pub func kind_iouring(): int {
    return 4;
}

// control ops
pub func ev_add(): int {
    return 1;
}
pub func ev_mod(): int {
    return 2;
}
pub func ev_del(): int {
    return 3;
}

// interest / revents bits
pub func ev_read(): int {
    return 1;
}
pub func ev_write(): int {
    return 2;
}
pub func ev_err(): int {
    return 4;
}
pub func ev_hup(): int {
    return 8;
}

/// is `kind` compiled in and usable on this host?
pub func backend_available(kind: int): bool {
    return __sloth_ev_available(kind) != 0;
}

pub func backend_name(kind: int): str {
    return __sloth_ev_backend_name(kind);
}

/// open a backend loop (0 on failure)
pub func ev_new(kind: int): EvLoop {
    return __sloth_ev_new(kind);
}

pub func ev_free(ev: EvLoop): unit {
    __sloth_ev_free(ev);
}

pub func ev_wakeup(ev: EvLoop): unit {
    __sloth_ev_wakeup(ev);
}

pub func ev_ctl(ev: EvLoop, op: int, fd: int, events: int, token: int): int {
    return __sloth_ev_ctl(ev, op, fd, events, token);
}

pub func ev_poll(ev: EvLoop, timeout_ms: int, out: EvBuf): int {
    return __sloth_ev_poll(ev, timeout_ms, out);
}

pub func evbuf_new(cap: int): EvBuf {
    return __sloth_evbuf_new(cap);
}

pub func evbuf_free(b: EvBuf): unit {
    __sloth_evbuf_free(b);
}

pub func evbuf_count(b: EvBuf): int {
    return __sloth_evbuf_count(b);
}

pub func evbuf_token(b: EvBuf, i: int): int {
    return __sloth_evbuf_token(b, i);
}

pub func evbuf_events(b: EvBuf, i: int): int {
    return __sloth_evbuf_events(b, i);
}

// raw string helpers shared with the HTTP parser

/// first index of `needle` in `hay` at/after `from`, or -1
pub func str_find(hay: str, needle: str, from: int): int {
    return __sloth_str_find(hay, needle, from);
}

pub func str_starts_with(s: str, prefix: str): bool {
    return __sloth_str_starts_with(s, prefix) != 0;
}

pub func str_slice(s: str, start: int, len: int): str {
    return __sloth_str_slice(s, start, len);
}

pub func str_len(s: str): int {
    return len(s);
}

pub func str_byte(s: str, i: int): int {
    return __sloth_str_byte(s, i);
}

pub func str_of_byte(v: int): str {
    return __sloth_str_of_byte(v);
}

pub func str_cmp(a: str, b: str): int {
    return __sloth_str_cmp(a, b);
}
