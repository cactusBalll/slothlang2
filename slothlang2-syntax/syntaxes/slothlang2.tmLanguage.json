{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "slothlang2",
  "scopeName": "source.slothlang2",
  "fileTypes": ["sl", "slt"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#function-calls" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.slothlang2",
          "begin": "/\\*",
          "end": "\\*/",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.begin.slothlang2" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.comment.end.slothlang2" }
          }
        },
        {
          "name": "comment.line.double-slash.slothlang2",
          "match": "//.*$"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(import)\\s+(\"(?:[^\"\\\\]|\\\\.)*\")(?:\\s+(as)\\s+([A-Za-z_][A-Za-z0-9_]*))?",
          "captures": {
            "1": { "name": "keyword.other.import.slothlang2" },
            "2": { "name": "string.quoted.double.slothlang2" },
            "3": { "name": "keyword.other.import.slothlang2" },
            "4": { "name": "entity.name.namespace.slothlang2" }
          }
        },
        {
          "match": "\\b(func)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.function.slothlang2" },
            "2": { "name": "entity.name.function.slothlang2" }
          }
        },
        {
          "match": "\\b(class)\\s+([A-Za-z_][A-Za-z0-9_]*)(?:\\s*:\\s*([A-Za-z_][A-Za-z0-9_]*))?(?:\\s*(impl)\\s+([A-Za-z_][A-Za-z0-9_]*(?:\\s*,\\s*[A-Za-z_][A-Za-z0-9_]*)*))?",
          "captures": {
            "1": { "name": "storage.type.class.slothlang2" },
            "2": { "name": "entity.name.type.class.slothlang2" },
            "3": { "name": "entity.other.inherited-class.slothlang2" },
            "4": { "name": "keyword.other.impl.slothlang2" },
            "5": { "name": "entity.name.type.trait.slothlang2" }
          }
        },
        {
          "match": "\\b(trait)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.trait.slothlang2" },
            "2": { "name": "entity.name.type.trait.slothlang2" }
          }
        },
        {
          "match": "\\b(extern)\\s+(func|type)\\b",
          "captures": {
            "1": { "name": "storage.modifier.extern.slothlang2" },
            "2": { "name": "storage.type.slothlang2" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.slothlang2",
          "match": "\\b(if|else|while|for|return|break|continue)\\b"
        },
        {
          "name": "keyword.operator.word.slothlang2",
          "match": "\\b(and|or|not|is)\\b"
        },
        {
          "name": "keyword.other.slothlang2",
          "match": "\\b(import|as|impl|pub|extern)\\b"
        },
        {
          "name": "storage.type.slothlang2",
          "match": "\\b(var|let)\\b"
        },
        {
          "name": "storage.type.function.slothlang2",
          "match": "\\bfunc\\b"
        },
        {
          "name": "storage.type.class.slothlang2",
          "match": "\\bclass\\b"
        },
        {
          "name": "storage.type.trait.slothlang2",
          "match": "\\btrait\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.slothlang2",
          "match": "\\b(int|int8|int16|int32|int64|uint|uint8|uint16|uint32|uint64|i8|i16|i32|i64|u8|u16|u32|u64|float|bool|str|unit|range|any)\\b"
        },
        {
          "name": "storage.type.slothlang2",
          "match": "\\b(Array|Map|Weak|Tensor|Fiber|Channel|AtomicInt|Mutex|JoinHandle|Option|Result|Display|Iterator|Iterable)\\b"
        },
        {
          "name": "storage.modifier.dyn.slothlang2",
          "match": "\\bdyn\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.slothlang2",
          "match": "\\b(true|false|nil)\\b"
        },
        {
          "name": "variable.language.slothlang2",
          "match": "\\b(this|super)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.slothlang2",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.slothlang2" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.slothlang2" }
          },
          "patterns": [
            { "include": "#string-escapes" },
            { "include": "#interpolation" }
          ]
        }
      ]
    },
    "string-escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.slothlang2",
          "match": "\\\\(?:[ntr\"\\\\${}])"
        },
        {
          "name": "invalid.illegal.escape.slothlang2",
          "match": "\\\\."
        }
      ]
    },
    "interpolation": {
      "begin": "\\$\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.template-expression.begin.slothlang2" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.template-expression.end.slothlang2" }
      },
      "contentName": "meta.embedded.expression.slothlang2",
      "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#numbers" },
        { "include": "#constants" },
        { "include": "#types" },
        { "include": "#keywords" },
        { "include": "#function-calls" },
        { "include": "#operators" },
        { "include": "#punctuation" }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.slothlang2",
          "match": "\\b[0-9]+\\.[0-9]+(?:[eE][-+]?[0-9]+)?"
        },
        {
          "name": "constant.numeric.float.slothlang2",
          "match": "\\b[0-9]+[eE][-+]?[0-9]+"
        },
        {
          "name": "constant.numeric.integer.slothlang2",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "match": "\\b([A-Z][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.type.slothlang2" }
          }
        },
        {
          "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.slothlang2" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.slothlang2",
          "match": "(?:\\|>|\\.\\.=|\\.\\.\\.|\\.\\.|->|\\?:|\\?\\.|<<=?|>>=?|<=|>=|==|!=|&&|\\|\\||\\+=|-=|[-+*/%=<>!&|^~?])"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.definition.map.slothlang2",
          "match": "@"
        },
        {
          "name": "punctuation.separator.slothlang2",
          "match": "[,;]"
        },
        {
          "name": "punctuation.separator.key-value.slothlang2",
          "match": ":"
        },
        {
          "name": "punctuation.accessor.slothlang2",
          "match": "\\."
        },
        {
          "name": "punctuation.section.parens.slothlang2",
          "match": "[()]"
        },
        {
          "name": "punctuation.section.brackets.slothlang2",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.section.braces.slothlang2",
          "match": "[{}]"
        }
      ]
    }
  }
}
